{
  "name": "mastra-desktop",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "movcl",
  "homepage": "https://mastra-desktop.app",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.mastra.json",
    "start": "node scripts/install-browser.mjs && electron-vite build && electron-vite preview",
    "dev": "node scripts/install-browser.mjs && electron-vite dev",
    "build": "node scripts/install-browser.mjs && pnpm run typecheck && mastra build && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
