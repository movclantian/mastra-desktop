{
  "name": "mastra-desktop",
  "version": "0.0.5",
  "description": "Local-first multi-agent coding workbench built on Electron, React and the Mastra framework",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "author": "mastra-desktop contributors",
  "homepage": "https://github.com/movclantian/mastra-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movclantian/mastra-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/movclantian/mastra-desktop/issues"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "sync:docs": "node scripts/sync-mastra-docs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.mastra.json",
    "start": "node scripts/install-prepare.mjs && electron-vite build && electron-vite preview",
    "dev": "node scripts/install-prepare.mjs && electron-vite dev",
    "build": "node scripts/install-prepare.mjs && pnpm run typecheck && node scripts/build-mastra.mjs && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
