{
  "name": "mastra-desktop",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "movcl",
  "homepage": "https://mastra-desktop.app",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.mastra.json",
    "start": "electron-vite preview",
    "dev": "concurrently -n mastra,electron -c cyan,green \"mastra dev\" \"electron-vite dev\"",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.42",
    "@ai-sdk/react": "4.0.69",
    "@base-ui/react": "1.7.0",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@mastra/ai-sdk": "1.8.0",
    "@mastra/core": "1.59.0",
    "@mastra/duckdb": "1.6.1",
    "@mastra/libsql": "1.20.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.17.0",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@rive-app/react-webgl2": "4.32.0",
    "@shadcn/react": "0.3.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@xyflow/react": "12.11.3",
    "ai": "7.0.66",
    "ansi-to-react": "6.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "mastra": "1.25.0",
    "media-chrome": "4.19.2",
    "motion": "13.1.0",
    "nanoid": "6.0.1",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.1",
    "react-jsx-parser": "2.4.1",
    "react-resizable-panels": "4.12.3",
    "recharts": "3.8.0",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tokenlens": "1.3.1",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "^10.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
