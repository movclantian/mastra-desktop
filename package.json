{
  "name": "mastra-desktop",
  "version": "0.0.4",
  "description": "Local-first multi-agent coding workbench built on Electron, React and the Mastra framework",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "author": "mastra-desktop contributors",
  "homepage": "https://github.com/movclantian/mastra-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movclantian/mastra-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/movclantian/mastra-desktop/issues"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false .",
    "lint:fix": "biome check --write .",
    "clean:package": "node scripts/clean-package-output.mjs",
    "test:regression": "node --test scripts/test-experience-regressions.mjs scripts/test-background-task-stream.mjs scripts/test-capability-regressions.mjs scripts/test-workspace-tool-regressions.mjs scripts/test-library-attachment-regressions.mjs && node --import jiti/register --test scripts/test-provider-routing.mjs scripts/test-thread-transfer-storage.mjs scripts/test-thread-transfer-recovery.mjs scripts/test-plan-draft-symlink.mjs",
    "verify:release": "node scripts/verify-release-source.mjs",
    "verify:package": "node scripts/verify-package-artifacts.mjs",
    "verify:package:dir": "node scripts/verify-package-artifacts.mjs --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.mastra.json",
    "start": "node scripts/install-browser.mjs && electron-vite build && electron-vite preview",
    "dev": "node scripts/install-browser.mjs && electron-vite dev",
    "build": "node scripts/install-browser.mjs && pnpm run typecheck && node scripts/build-mastra.mjs && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
