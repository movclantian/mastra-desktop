{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!.vscode",
      "!out",
      "!node_modules",
      "!.mastra",
      "!.zvec-grep",
      "!src/mastra/public",
      "!build",
      "!dist",
      "!resources",
      "!docs",
      "!.agent/core-patch",
      "!.agent/runtime-evidence",
      "!dist-review-*",
      "!**/*.config.*",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "auto"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noDocumentCookie": "off",
        "noRedeclare": "off",
        "noDoubleEquals": "off"
      },
      "correctness": { "useExhaustiveDependencies": "off", "noUnusedImports": "off" },
      "a11y": "off",
      "style": { "noDescendingSpecificity": "off" },
      "security": { "noDangerouslySetInnerHtml": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/renderer/src/components/ui/**",
        "src/renderer/src/components/ai-elements/**"
      ],
      "linter": {
        "rules": {
          "a11y": "off",
          "correctness": {
            "useExhaustiveDependencies": "off",
            "noUnusedFunctionParameters": "off",
            "useJsxKeyInIterable": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noExplicitAny": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "complexity": {
            "noUselessFragments": "off"
          }
        }
      }
    }
  ]
}
